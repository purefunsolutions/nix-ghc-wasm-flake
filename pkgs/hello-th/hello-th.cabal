cabal-version:   3.0
name:            hello-th
version:         0.1.0.0
synopsis:        Template Haskell hello world for GHC's wasm backend
license:         MIT
author:          Mika Tammi
maintainer:      mikatammi@gmail.com
category:        Example
build-type:      Simple
extra-doc-files: expected-output.txt

executable hello-th
  main-is:          Main.hs
  other-modules:    Greeting
  build-depends:
    , base
    , template-haskell

  default-language: Haskell2010
  ghc-options:      -Wall
