cabal-version:      3.0
name:               hello-wasm
version:            0.1.0.0
synopsis:           Hello world for GHC's wasm backend, built purely with Nix
license:            MIT
author:             Mika Tammi
maintainer:         mikatammi@gmail.com
category:           Example
build-type:         Simple
extra-doc-files:    expected-output.txt

executable hello-wasm
  main-is:          Main.hs
  hs-source-dirs:   app
  c-sources:        cbits/hello.c
  build-depends:    base
  default-language: Haskell2010
  ghc-options:      -Wall
